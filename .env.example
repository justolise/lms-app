# PostgreSQL runtime connection (API)
DATABASE_URL=postgresql://lms_app:replace_with_local_password@127.0.0.1:5432/lms

# PostgreSQL migration connection (Drizzle Kit only)
MIGRATION_DATABASE_URL=postgresql://lms_migrator:replace_with_migration_password@127.0.0.1:5432/lms

# Redis development connection
REDIS_URL=redis://:devpassword@127.0.0.1:6379

# HMAC-SHA-256 key for cross-library identity lookup (32-byte base64)
IDENTITY_LOOKUP_HMAC_KEY=replace_with_a_secure_32_byte_base64_key

# Authentication token signing secrets (32-byte base64)
ACCESS_TOKEN_SECRET=replace_with_a_secure_32_byte_base64_key
LIBRARY_SELECTION_TOKEN_SECRET=replace_with_another_secure_32_byte_base64_key

# MEM-1: Member identification document protection
MEMBER_IDENTIFIER_ENCRYPTION_KEY=replace_with_a_secure_32_byte_base64_key
MEMBER_IDENTIFIER_HMAC_KEY=replace_with_another_secure_32_byte_base64_key

# Notification & OTP Delivery (AUTH-3)
# Email delivery via SMTP
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@lms.local
SMTP_PASS=replace_with_smtp_password
SMTP_FROM="LMS Library Support <noreply@lms.local>"

# SMS delivery via Africa's Talking (Kenya / East Africa)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=replace_with_africastalking_api_key
AFRICASTALKING_FROM=LMS

# Application Base URLs & CORS Configuration
# Next.js web application frontend URL
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001

# NestJS API backend URL
API_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000

# CORS Allowed Origins for API (comma-separated list of permitted web origins)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# CAT-2: ISBN Metadata Lookup (server-side only — never exposed to browser)
# Open Library: free, no API key required
OPEN_LIBRARY_API_URL=https://openlibrary.org
# Google Books: optional fallback; leave blank to skip Google Books lookup
GOOGLE_BOOKS_API_URL=https://www.googleapis.com/books/v1
GOOGLE_BOOKS_API_KEY=
